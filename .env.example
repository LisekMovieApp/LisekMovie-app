# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database (matches docker-compose.yml defaults if you used it) ---
DATABASE_URL=postgres://lisekmovie:lisekmovie@localhost:5432/lisekmovie

# --- Server ---
LISEK_BIND_ADDR=0.0.0.0:8080
# 32-byte key that encrypts metadata provider API keys in the database
# (64 hex characters or base64). Generated and written to .env on first
# start when empty. Back it up with the database: if it is lost, provider
# API keys must be entered again. e.g.: openssl rand -hex 32
LISEK_SECRET_KEY=
# Browser origins allowed to call the API from another origin
# (comma-separated). Leave empty when the web app is served from the same
# origin as the API (the default setup).
LISEK_CORS_ORIGINS=

# --- Metadata providers ---
# TMDB ships with a built-in default key — only set this to override it
# with your own.
TMDB_API_KEY=
# TheTVDB has no default key: the provider stays disabled until you set this.
TVDB_API_KEY=
# OMDb (Faza 7): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# --- Web Push (VAPID) — only needed once push notifications are enabled ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional FFmpeg executables. A path saved in Admin > Playback overrides these.
# LISEK_FFMPEG=C:/ffmpeg/bin/ffmpeg.exe
# LISEK_FFPROBE=C:/ffmpeg/bin/ffprobe.exe
