{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.representative_item_id AS \"card_id!\",\n               (e.created_at >= now() - make_interval(days => $2)) AS \"is_recent!\",\n               e.season_number\n        FROM series s\n        JOIN episodes e ON e.series_id = s.id\n        WHERE s.representative_item_id = ANY($1)\n        ",
